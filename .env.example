# ==============================================================================
# Andro Buddy AI Chatbot - Environment Variables
# ==============================================================================
# This project is configured to use 100% FREE AI models via Groq!
#
# 1. Sign up for a free Groq account (No credit card required):
#    https://console.groq.com/keys
# 2. Click "Create API Key", copy the key (starts with "gsk_...")
# 3. Paste it into your .env.local file:
# ==============================================================================

GROQ_API_KEY=

# Note: Even without an API key, you can immediately test the application
# using the built-in "Demo Assistant (Offline)" model from the top dropdown!
